STRATAON-MIB DEFINITIONS ::= BEGIN

IMPORTS
    MODULE-IDENTITY,
    OBJECT-IDENTITY,
    OBJECT-TYPE,
    enterprises,
    Integer32,
    Gauge32,
    TimeTicks
        FROM SNMPv2-SMI
    DisplayString,
    TEXTUAL-CONVENTION
        FROM SNMPv2-TC
    MODULE-COMPLIANCE,
    OBJECT-GROUP
        FROM SNMPv2-CONF;

strataonMIB MODULE-IDENTITY
    LAST-UPDATED "202609111235Z"
    ORGANIZATION "STRATAON Equipamentos Eletronicos Ltda."
    CONTACT-INFO
        "STRATAON
         Web: https://strataon.com.br
         E-mail: suporte@strataon.com.br"
    DESCRIPTION
        "STRATAON enterprise MIB using the official IANA Private Enterprise Number 66204.

         This MIB contains common STRATAON objects and product-specific branches
         for current and future STRATAON products. Current product IDs are:
         1 = miniPLC, 2 = smartPDU, 3 = miniENV, 4 = sentiaMAN, 5 = sentiaPRO,
         6 = sentiaLOK."
    REVISION "202609111235Z"
    DESCRIPTION
        "Version 1.8. Added sentiaLOK product branch at .10.6. The sentiaLOK
         exposes 32 subordinate station slots. Each station provides node, name,
         communication status, firmware, device type, eight digital inputs and
         eight digital outputs. Station attributes use subidentifiers 101 through
         132. Product ID 6 is assigned to sentiaLOK."
    REVISION "202608162321Z"
    DESCRIPTION
        "Version 1.7. Added sentiaPRO product branch at .10.5. The sentiaPRO
         exposes one set of product-specific environmental and access state
         objects: three temperatures, one humidity value, alarm state, two
         lock states and two door states. Temperature and humidity values use
         scale x10. Product ID 5 is assigned to sentiaPRO."
    REVISION "202608162100Z"
    DESCRIPTION
        "Version 1.6. Added sentiaMAN product branch at .10.4. The sentiaMAN
         exposes a fixed count of subordinate station slots and 13 station
         attribute branches using subidentifiers 101 through 132. Attributes
         include node number, station name, communication status, firmware,
         three temperatures, humidity, alarm state, two lock states and two
         door states. Temperature and humidity values use scale x10."
    REVISION "202608112114Z"
    DESCRIPTION
        "Version 1.5. Corrected miniENV environmental measurement units.
         Humidity inputs HUM01 and HUM02 are represented as percent RH x10.
         CO2 input CO201 is represented directly in ppm, without x10 scaling.
         No object identifiers were changed."
    REVISION "202607311241Z"
    DESCRIPTION
        "Version 1.4. Publication release consolidating the validated
         STRATAON MIB definitions for miniPLC, smartPDU and miniENV.
         No object identifiers or object semantics were changed from
         version 1.3.4."
    REVISION "202607311130Z"
    DESCRIPTION
        "Version 1.3.4. Reorganized only the smartPDU relay OIDs.
         Relay count remains at subidentifier 1, relay states now use
         subidentifiers 101 through 108, and persistent relay activation
         counters also use subidentifiers 101 through 108."
    REVISION "202607311100Z"
    DESCRIPTION
        "Version 1.3.3. Reorganized only the miniPLC product variable OIDs.
         Count objects remain at subidentifier 1 and DI, DO, BOOL and LONG
         variables now use subidentifiers 101 through 132, preserving
         natural channel ordering in SNMP monitoring tools."
    REVISION "202607310953Z"
    DESCRIPTION
        "Version 1.3.1. Reorganized miniENV product variable OIDs so that
         count remains at subidentifier 1 and variables use subidentifiers
         101 onward. This preserves natural channel ordering in SNMP
         monitoring tools such as PRTG."
    REVISION "202607301900Z"
    DESCRIPTION
        "Version 1.3. Added the miniENV product branch at .10.3 with
         9 digital inputs, 2 digital outputs, 32 boolean variables,
         32 signed long variables, 5 temperature values, 2 humidity
         values and 1 CO2 value. Environmental values use scale x10."
    REVISION "202607250000Z"
    DESCRIPTION
        "Added eight persistent smartPDU relay activation counters under
         smartPDU relay statistics at .10.2.2."
    REVISION "202607091230Z"
    DESCRIPTION
        "Refined miniPLC boolean branch naming and added StrataonBinaryState
         textual convention for binary state objects."
    REVISION "202607091205Z"
    DESCRIPTION
        "Aligned product branches with firmware layout:
         common system at .1, common network at .2, products at .10,
         miniPLC at .10.1 and smartPDU at .10.2. Count objects are
         first in each product group and variables start at subidentifier 2."
    REVISION "202607090900Z"
    DESCRIPTION
        "Updated the enterprise root to the official IANA Private Enterprise Number 66204."
    REVISION "202607070100Z"
    DESCRIPTION
        "Adjusted count objects to avoid using zero as the last subidentifier of OBJECT-TYPE definitions."
    REVISION "202607070000Z"
    DESCRIPTION
        "Initial STRATAON MIB with common system/network groups,
         miniPLC product branch and smartPDU product branch."
    ::= { enterprises 66204 }

-- =============================================================
-- Textual conventions
-- =============================================================

StrataonBinaryState ::= TEXTUAL-CONVENTION
    STATUS current
    DESCRIPTION
        "Generic binary state used by STRATAON objects.
         off(0) means disabled, inactive or de-energized.
         on(1) means enabled, active or energized.
         The exact physical meaning depends on the object description."
    SYNTAX INTEGER {
        off(0),
        on(1)
    }

-- =============================================================
-- Root branches
-- =============================================================

strataonSystem OBJECT-IDENTITY
    STATUS current
    DESCRIPTION "Common system information for STRATAON devices."
    ::= { strataonMIB 1 }

strataonNetwork OBJECT-IDENTITY
    STATUS current
    DESCRIPTION "Common network information for STRATAON devices."
    ::= { strataonMIB 2 }

strataonProducts OBJECT-IDENTITY
    STATUS current
    DESCRIPTION "STRATAON product-specific branches."
    ::= { strataonMIB 10 }

strataonNotifications OBJECT-IDENTITY
    STATUS current
    DESCRIPTION "Reserved branch for future SNMP notifications/traps."
    ::= { strataonMIB 20 }

strataonConformance OBJECT-IDENTITY
    STATUS current
    DESCRIPTION "Conformance statements for STRATAON MIB."
    ::= { strataonMIB 30 }

-- =============================================================
-- Common system group: 1.3.6.1.4.1.66204.1
-- =============================================================

strataonProductId OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "STRATAON product ID. miniPLC=1, smartPDU=2, miniENV=3, sentiaMAN=4, sentiaPRO=5, sentiaLOK=6."
    ::= { strataonSystem 1 }

strataonUptime OBJECT-TYPE
    SYNTAX TimeTicks
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Device uptime in hundredths of seconds."
    ::= { strataonSystem 2 }

strataonHeapFree OBJECT-TYPE
    SYNTAX Gauge32
    UNITS "bytes"
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Current free heap memory."
    ::= { strataonSystem 3 }

strataonHeapMinimum OBJECT-TYPE
    SYNTAX Gauge32
    UNITS "bytes"
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Minimum free heap memory since boot."
    ::= { strataonSystem 4 }

strataonResetReason OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Device reset reason code."
    ::= { strataonSystem 5 }

strataonCpuFrequency OBJECT-TYPE
    SYNTAX Gauge32
    UNITS "MHz"
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "CPU frequency in MHz."
    ::= { strataonSystem 6 }

strataonModel OBJECT-TYPE
    SYNTAX DisplayString
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Device model string."
    ::= { strataonSystem 7 }

strataonSerialNumber OBJECT-TYPE
    SYNTAX DisplayString
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Device serial number."
    ::= { strataonSystem 8 }

strataonFirmwareVersion OBJECT-TYPE
    SYNTAX DisplayString
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Firmware version string."
    ::= { strataonSystem 9 }

strataonBuildDate OBJECT-TYPE
    SYNTAX DisplayString
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Firmware build date."
    ::= { strataonSystem 10 }

strataonSdkVersion OBJECT-TYPE
    SYNTAX DisplayString
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "SDK or ESP-IDF version string."
    ::= { strataonSystem 11 }

strataonBuildTime OBJECT-TYPE
    SYNTAX DisplayString
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Firmware build time."
    ::= { strataonSystem 12 }

