-- =============================================================
-- miniPLC branches: 1.3.6.1.4.1.66204.10.1
-- =============================================================

miniPLCDigitalInputs OBJECT-IDENTITY
    STATUS current
    DESCRIPTION "miniPLC digital inputs. Count is subidentifier 1; DI01 starts at subidentifier 101."
    ::= { strataonMiniPLC 1 }

miniPLCDigitalOutputs OBJECT-IDENTITY
    STATUS current
    DESCRIPTION "miniPLC digital outputs. Count is subidentifier 1; DO01 starts at subidentifier 101."
    ::= { strataonMiniPLC 2 }

miniPLCBooleanVariables OBJECT-IDENTITY
    STATUS current
    DESCRIPTION "miniPLC boolean variables. Count is subidentifier 1; BOOL01 starts at subidentifier 101."
    ::= { strataonMiniPLC 3 }

miniPLCLongVariables OBJECT-IDENTITY
    STATUS current
    DESCRIPTION "miniPLC signed 32-bit long integer variables. Count is subidentifier 1; LONG01 starts at subidentifier 101."
    ::= { strataonMiniPLC 4 }

miniPLCDigitalInputCount OBJECT-TYPE
    SYNTAX Integer32 (0..2147483647)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Number of miniPLC digital inputs currently implemented."
    ::= { miniPLCDigitalInputs 1 }

miniPLCDigitalOutputCount OBJECT-TYPE
    SYNTAX Integer32 (0..2147483647)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Number of miniPLC digital outputs currently implemented."
    ::= { miniPLCDigitalOutputs 1 }

miniPLCBooleanVariableCount OBJECT-TYPE
    SYNTAX Integer32 (0..2147483647)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Number of miniPLC boolean variables currently implemented."
    ::= { miniPLCBooleanVariables 1 }

miniPLCLongVariableCount OBJECT-TYPE
    SYNTAX Integer32 (0..2147483647)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Number of miniPLC long integer variables currently implemented."
    ::= { miniPLCLongVariables 1 }

